{
  "profile_id": "classical_romantic",
  "display_name": "Classical / Romantic Solo Piano",
  "description": "Expressive rubato tempo elasticity, wide dynamic range, legitimate 16th-note runs/ornaments, and flexible hand crossing.",
  "transcription": {
    "default_grid": 4,
    "tempo_mode_preference": "tempo-map",
    "allow_swing": false
  },
  "pitch_audit": {
    "ghost_f0_gap_db": 13.5,
