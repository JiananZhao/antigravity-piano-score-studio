    "weak_oos_snr_db": 11.0,
    "allow_chromatic_clusters": false
  },
  "engraving": {
    "split_center": 62.0,
    "lh_max_pitch": 67,
    "rh_min_pitch": 55,
    "max_hand_span": 12,
    "enable_gap_bridging": true,
    "bridge_rms_db": -40.0,
    "anchor_min_dur_beats": 1.5,
    "max_voices_per_hand": 2
  },
  "dynamics": {
    "pedal_style": "romantic_rubato",
    "target_rh_lh_diff_db": 2.5,
    "lh_ceiling_vel": 100
  },
  "eval_rubric": {
    "s1_min_circular_r_pass": 0.50,
    "s1_max_drift_ms_pass": 60.0,
    "s1_require_downbeat_peak": false,
    "s1_spurious_16_pass_pct": 12.0,
    "s1_spurious_16_warn_pct": 25.0,
    "s3_max_spurious_16_pass": 12,
    "s3_max_spurious_16_warn": 30,
    "s3_max_rests_per_bar_pass": 3.5,
    "s3_max_rests_per_bar_warn": 5.5,
    "s3_max_mid_clef_changes_pass": 2,
    "s4_max_lh_vel_pass": 102,
    "s4_min_rh_lh_diff_pass": 4
  }
